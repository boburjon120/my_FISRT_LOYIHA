# ================== AURIX Downloader sozlamalari ==================
# Bu faylni .env nomi bilan nusxalang:  cp .env.example .env
# So'ng quyidagi qiymatlarni to'ldiring. .env faylini HECH KIMGA bermang!

# --- MAJBURIY ---
# @BotFather bergan bot token
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Admin Telegram ID lari (vergul bilan). ID ni @userinfobot dan bilib oling
ADMIN_IDS=123456789

# --- Kanallar (bot ichidan ham o'rnatish mumkin) ---
# Telegram kanal: @kanal_username yoki -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
# Kuzatiladigan YouTube kanal: https://www.youtube.com/@kanal yoki UC... ID
YOUTUBE_CHANNEL=

# --- Monitoring ---
# Tekshirish oralig'i (soniya). 300 = 5 daqiqa
CHECK_INTERVAL_SECONDS=300
# Bot o'chiq bo'lgan vaqtda chiqqan videolarni necha soat orqaga qarab olish
LOOKBACK_HOURS=48
# Kanal birinchi marta qo'shilganda nechta so'nggi videoni ham joylash (0 = faqat yangilari)
INITIAL_BACKFILL_COUNT=0

# --- Audio / yuklash ---
AUDIO_BITRATE_KBPS=192
MIN_AUDIO_BITRATE_KBPS=64
MAX_CONCURRENT_DOWNLOADS=2
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=60
CHANNEL_MAX_DURATION_MINUTES=240
USER_MAX_DURATION_MINUTES=120
USER_RATE_LIMIT_SECONDS=20

# Telegram bot fayl limiti (MB). Oddiy Bot API: 50
UPLOAD_LIMIT_MB=50
# Ixtiyoriy: o'zingizning Local Bot API server (2000 MB gacha). Bo'sh qoldiring
TELEGRAM_API_URL=

# Ixtiyoriy: YouTube "Sign in to confirm you're not a bot" xatosi chiqsa,
# O'Z akkauntingiz cookies.txt fayli yo'li (konteyner ichida, masalan /app/data/cookies.txt).
# Yopiq/pullik/yosh cheklovli videolar baribir YUKLANMAYDI.
YTDLP_COOKIES_FILE=

NOTIFY_ADMINS_ON_FAILURE=true
LOG_LEVEL=INFO

# Ixtiyoriy: /health web serveri porti. Render o'zi PORT beradi. VPS da bo'sh qoldiring.
PORT=
